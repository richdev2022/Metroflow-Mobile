# Metroflow backend API (must include the /api prefix).
# Production (VPS behind api.metricorex.com):
EXPO_PUBLIC_API_BASE_URL=https://api.metricorex.com/api
# Local development (Android emulator uses 10.0.2.2 to reach host localhost):
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000/api

# Google Sign-In Web client ID (required on Android so google_sign_in returns an ID token):
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=438902996656-dbmnffpr8vufvso2o10esspalvl9c25c.apps.googleusercontent.com

# E2E payload encryption — MUST match the backend's PAYLOAD_ENCRYPTION_KEY
# (32-byte base64). When empty the app uses plaintext automatically.
EXPO_PUBLIC_PAYLOAD_ENCRYPTION_KEY=+vxz/9GryKSwyy/+xu9p3AEpmPmDHWb+hWRRE+FFq3I=
