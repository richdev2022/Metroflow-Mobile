<?xml version="1.0" encoding="utf-8"?>
<!-- Branded launch screen: white background + centered official shield mark.
     Visible until the Flutter engine draws its first frame (the animated
     Flutter splash takes over from there). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_image" />
    </item>
</layer-list>
