source "https://rubygems.org"

gem "fastlane", "~> 2.226"
# CocoaPods is preinstalled on GitHub macOS runners and on dev Macs, so it is
# intentionally NOT bundled here (keeps `bundle install` fast on CI).

plugins_path = File.join(File.dirname(__FILE__), "fastlane", "Pluginfile")
eval_gemfile(plugins_path) if File.exist?(plugins_path)
