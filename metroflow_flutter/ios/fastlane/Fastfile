# Fastfile — Metricorex iOS → TestFlight pipeline.
#
# Auth model: App Store Connect API key ONLY (no Apple ID password, no 2FA
# prompts, works headlessly on CI). The key is provided via ENV:
#   APP_STORE_CONNECT_KEY_ID      — ASC API Key ID          (e.g. ABC123XYZ9)
#   APP_STORE_CONNECT_ISSUER_ID   — ASC API Issuer ID       (a UUID)
#   APP_STORE_CONNECT_KEY_P8      — the .p8 file, base64-encoded
#   APPLE_TEAM_ID                 — 10-char Apple Team ID
# See docs/TESTFLIGHT_SETUP.md for how to generate them (5 minutes).

default_platform(:ios)

# gym runs `xcodebuild -showBuildSettings` to sniff project settings; on this
# project (Flutter + SwiftPM + CocoaPods) that command takes >30s on CI and the
# 3s default times out after 4 retries. Give it a real budget.
ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] ||= "60"
ENV["FASTLANE_XCODEBUILD_SETTINGS_RETRIES"] ||= "5"

APP_IDENTIFIER = "com.metricorex.app"
APP_NAME = "Metricorex"

platform :ios do
  # ---------------------------------------------------------------- helpers
  def asc_api_key!
    key_id = ENV["APP_STORE_CONNECT_KEY_ID"]
    issuer = ENV["APP_STORE_CONNECT_ISSUER_ID"]
    raw = ENV["APP_STORE_CONNECT_KEY_P8"]
    UI.user_error!("APP_STORE_CONNECT_KEY_ID missing") if key_id.to_s.empty?
    UI.user_error!("APP_STORE_CONNECT_ISSUER_ID missing") if issuer.to_s.empty?
    UI.user_error!("APP_STORE_CONNECT_KEY_P8 missing") if raw.to_s.empty?

    # Accept both raw PEM content and base64-encoded .p8.
    content =
      begin
        require "base64"
        decoded = Base64.strict_decode64(raw)
        decoded.include?("PRIVATE KEY") ? decoded : raw
      rescue StandardError
        raw
      end

    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer,
      key_content: content,
      is_key_content_base64: false,
      duration: 1200, # 20 min — covers archive + upload
    )
  end

  def cloud_signing_xcargs!
    team = ENV["APPLE_TEAM_ID"]
    key_id = ENV["APP_STORE_CONNECT_KEY_ID"]
    UI.user_error!("APPLE_TEAM_ID missing") if team.to_s.empty?
    UI.user_error!("APP_STORE_CONNECT_KEY_ID missing") if key_id.to_s.empty?
    key_path = File.expand_path(File.join(Dir.home, "private_keys"))
    # ⚠ -authenticationKeyPath expects the FULL PATH to the .p8 FILE, not the
    # directory. Passing the directory makes xcodebuild fail instantly with
    # NSCocoaErrorDomain 256 ("Is a directory").
    key_file = File.join(key_path, "AuthKey_#{key_id}.p8")
    [
      "DEVELOPMENT_TEAM=#{team}",
      "-allowProvisioningUpdates",
      "-authenticationKeyPath #{key_file}",
      "-authenticationKeyID #{key_id}",
      "-authenticationKeyIssuerID #{ENV['APP_STORE_CONNECT_ISSUER_ID']}",
    ].join(" ")
  end

  # Ensures the bundle ID is registered and the "Metricorex" app record exists
  # on App Store Connect — using ONLY the ASC API key (the token set by
  # `app_store_connect_api_key` above authorizes every Spaceship::ConnectAPI
  # call). We deliberately avoid the `produce` action: it hard-requires an
  # Apple-ID `username` session ("No value found for 'username'" on CI), which
  # this pipeline intentionally doesn't use.
  # Idempotent: both steps are no-ops once the bundle ID / app record exist.
  def ensure_app_record!
    UI.message("Ensuring bundle ID #{APP_IDENTIFIER} is registered on App Store Connect…")
    unless Spaceship::ConnectAPI::BundleId.find(APP_IDENTIFIER)
      Spaceship::ConnectAPI::BundleId.create(
        name: APP_NAME,
        platform: Spaceship::ConnectAPI::BundleIdPlatform.map("ios"),
        identifier: APP_IDENTIFIER
      )
      UI.success("Bundle ID #{APP_IDENTIFIER} registered.")
    end

    UI.message("Ensuring App Store Connect app record for #{APP_IDENTIFIER}…")
    if Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
      UI.success("App record already exists — nothing to do.")
      return
    end

    Spaceship::ConnectAPI::App.create(
      name: APP_NAME,
      version_string: "1.0.0",
      sku: APP_IDENTIFIER,
      primary_locale: "en-US",
      bundle_id: APP_IDENTIFIER,
      platforms: [Spaceship::ConnectAPI::BundleIdPlatform.map("ios")],
      company_name: "Metricorex"
    )

    # App Store Connect lists newly created apps asynchronously — poll briefly.
    tries = 0
    while Spaceship::ConnectAPI::App.find(APP_IDENTIFIER).nil?
      tries += 1
      UI.crash!("App record not visible on App Store Connect after 2 minutes") if tries > 8
      UI.message("Waiting for the new app record to appear on App Store Connect…")
      sleep(15)
    end
    UI.success("App record for #{APP_IDENTIFIER} is ready.")
  end

  # ------------------------------------------------------------------ lanes
  desc "Create the Metricorex app record on App Store Connect (idempotent)"
  lane :create_app do
    asc_api_key!
    ensure_app_record!
  end

  desc "Build the iOS app and upload it to TestFlight"
  lane :beta do
    asc_api_key!

    # Idempotent: a no-op once the app record exists (first CI run creates
    # "Metricorex" on the developer account automatically).
    ensure_app_record!

    setup_ci

    # The Flutter AOT artifacts must already exist (CI runs
    # `flutter build ios --release --no-codesign` first). gym then archives
    # + signs + exports the IPA with cloud signing via the API key.
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      xcargs: cloud_signing_xcargs!,
      output_directory: "build/ios/ipa",
      output_name: "Metricorex",
      silent: true
    )

    upload_to_testflight(
      api_key: asc_api_key!,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true, # Apple processes async; CI exits after upload
      distribute_external: false,
      notify_external_testers: false
    )

    UI.success("Metricorex uploaded to TestFlight — Apple is processing it now.")
  end
end
