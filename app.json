{
  "expo": {
    "name": "Metroflow",
    "slug": "metroflow-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./Asset/appIcon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./Asset/Logo-white.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563eb"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./Asset/appIcon.png",
      "bundleIdentifier": "com.metroflow.metroflowapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./Asset/appIcon.png",
        "backgroundColor": "#6366f1"
      },
      "package": "com.metroflow.metroflowapp",
      "versionCode": 2
    },
    "web": {
      "favicon": "./Asset/appIcon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "buildToolsVersion": "34.0.0"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ec0e7114-7e2a-404b-92b9-1d80dc463cd9"
      }
    }
  }
}
